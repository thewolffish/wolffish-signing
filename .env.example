# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=thewolffish
GITHUB_REPO=wolffish-app

# Certum SimplySign
CERT_THUMBPRINT=YOUR_CERTIFICATE_SHA1_THUMBPRINT
SIGNTOOL_PATH=C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x64\signtool.exe

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# Cloudflare cache purge (releases.wolffi.sh is CDN-cached in front of R2).
# After re-uploading the signed .exe, the edge cache is purged so downloads
# stop serving the stale unsigned copy CI cached as immutable.
# CF_API_TOKEN needs the "Zone → Cache Purge" permission on the wolffi.sh zone.
CF_ZONE_ID=your_cloudflare_zone_id
CF_API_TOKEN=your_cloudflare_cache_purge_token
